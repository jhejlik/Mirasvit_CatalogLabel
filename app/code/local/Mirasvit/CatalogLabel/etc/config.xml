<?xml version="1.0" encoding="UTF-8"?>
<config>
    <modules>
        <Mirasvit_CatalogLabel>
            <version>0.0.4</version>
        </Mirasvit_CatalogLabel>
    </modules>
    <global>
        <models>
            <cataloglabel>
                <class>Mirasvit_CatalogLabel_Model</class>
                <resourceModel>cataloglabel_resource</resourceModel>
            </cataloglabel>

            <cataloglabel_resource>
                <class>Mirasvit_CatalogLabel_Model_Resource</class>
                <entities>
                    <label>
                        <table>m_cataloglabel_label</table>
                    </label>
                    <label_customer_group>
                        <table>m_cataloglabel_label_customer_group</table>
                    </label_customer_group>
                    <label_store>
                        <table>m_cataloglabel_label_store</table>
                    </label_store>
                    <placeholder>
                        <table>m_cataloglabel_placeholder</table>
                    </placeholder>
                    <label_attribute>
                        <table>m_cataloglabel_label_attribute</table>
                    </label_attribute>
                    <label_rule>
                        <table>m_cataloglabel_label_rule</table>
                    </label_rule>
                    <label_rule_product>
                        <table>m_cataloglabel_label_rule_product</table>
                    </label_rule_product>
                    <label_display>
                        <table>m_cataloglabel_label_display</table>
                    </label_display>
                </entities>
            </cataloglabel_resource>
        </models>
        <helpers>
            <cataloglabel>
                <class>Mirasvit_CatalogLabel_Helper</class>
            </cataloglabel>
        </helpers>
        <blocks>
            <cataloglabel>
                <class>Mirasvit_CatalogLabel_Block</class>
            </cataloglabel>
        </blocks>
        <resources>
            <cataloglabel_setup>
                <setup>
                    <module>Mirasvit_CatalogLabel</module>
                </setup>
            </cataloglabel_setup>
        </resources>
        <events>
            <core_block_abstract_to_html_after>
                <observers>
                    <cataloglabel>
                        <type>singleton</type>
                        <class>cataloglabel/observer_output</class>
                        <method>afterOutput</method>
                    </cataloglabel>
                </observers>
            </core_block_abstract_to_html_after>
        </events>
    </global>
    <frontend>
        <translate>
            <modules>
                <Mirasvit_CatalogLabel>
                    <files>
                        <default>Mirasvit_CatalogLabel.csv</default>
                    </files>
                </Mirasvit_CatalogLabel>
            </modules>
        </translate>
        <layout>
            <updates>
                <cataloglabel module="cataloglabel">
                    <file>mst_cataloglabel.xml</file>
                </cataloglabel>
            </updates>
        </layout>
        <routers>
            <cataloglabel>
                <use>standard</use>
                <args>
                    <module>Mirasvit_CatalogLabel</module>
                    <frontName>cataloglabel</frontName>
                </args>
            </cataloglabel>
        </routers>
    </frontend>
    <adminhtml>
        <acl>
            <all>
                <title>Allow Everything</title>
            </all>
            <resources>
                <admin>
                    <children>
                        <catalog>
                            <children>
                                <config>
                                    <children>
                                        <cataloglabel translate="title" module="cataloglabel">
                                            <title>Catalog Labels</title>
                                        </cataloglabel>
                                    </children>
                                </config>
                            </children>
                        </catalog>
                    </children>
                </admin>
            </resources>
        </acl>
        <layout>
            <updates>
                <cataloglabel module="cataloglabel">
                    <file>mst_cataloglabel.xml</file>
                </cataloglabel>
            </updates>
        </layout>
        <translate>
            <modules>
                <Mirasvit_CatalogLabel>
                    <files>
                        <default>Mirasvit_CatalogLabel.csv</default>
                    </files>
                </Mirasvit_CatalogLabel>
            </modules>
        </translate>
    </adminhtml>
    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <cataloglabel after="Mage_Adminhtml">Mirasvit_CatalogLabel_Adminhtml</cataloglabel>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>
    <default>
        <cataloglabel>
        </cataloglabel>
    </default>
        <crontab>
        <jobs>
            <cataloglabel>
                <schedule>
                    <cron_expr>7 * * * *</cron_expr>
                </schedule>
                <run>
                    <model>cataloglabel/observer::apply</model>
                </run>
            </cataloglabel>
        </jobs>
    </crontab>
</config>